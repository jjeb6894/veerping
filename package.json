{
  "name": "trustping",
  "version": "0.1.0",
  "private": true,
  "description": "TemplateChecklist listing reports and trust signals on Cloudflare Workers.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --experimental-strip-types tests/listing-parser.test.mjs && node --experimental-strip-types tests/listing-input.test.mjs",
    "typecheck": "tsc --noEmit",
    "worker:build": "opennextjs-cloudflare build",
    "preview": "npm run worker:build && opennextjs-cloudflare preview",
    "deploy": "npm run worker:build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "next": "^16.3.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "stripe": "16.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@opennextjs/cloudflare": "^1.20.7",
    "@types/node": "20.14.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

